{
  "schema": 1,
  "about": "Harness Slides visual contract: three slides proposed, approved by one whole-plan answer and bound to a composition, plus the refusals a caller must handle. Placeholders: {project} is an empty project directory, {fixture} is this directory, {output} is a new directory. given: empty (nothing yet), proposed (proposal.json proposed with --mode batch), approved (proposed, then one approve answer to the whole-plan question).",
  "proposal": "proposal.json",
  "composition": "composition.json",
  "approval": {"decision": "approve", "feedback": "Approve the whole plan"},
  "cases": [
    {"id": "qualification-missing", "given": "empty",
     "run": ["design", "propose", "--project", "{project}", "--file", "{fixture}/refusals/qualification-missing.json", "--json"],
     "problems": [{"code": "copy-qualification-missing", "slide": "reconcile_loop", "recoverable": true}]},
    {"id": "copy-mismatch", "given": "empty",
     "run": ["design", "propose", "--project", "{project}", "--file", "{fixture}/refusals/copy-mismatch.json", "--json"],
     "problems": [{"code": "copy-mismatch", "slide": "knowledge_check", "recoverable": true}]},
    {"id": "asset-unresolved", "given": "empty",
     "run": ["design", "propose", "--project", "{project}", "--file", "{fixture}/refusals/asset-unresolved.json", "--json"],
     "problems": [{"code": "asset-unresolved", "slide": "operator_architecture", "asset": "console_screenshot", "recoverable": true, "fallback": {"needsApproval": true}}]},
    {"id": "awaiting-approval", "given": "proposed",
     "run": ["design", "check", "--project", "{project}", "--json"],
     "problems": [{"code": "design-awaiting-approval", "slide": "operator_architecture"}, {"code": "design-awaiting-approval", "slide": "reconcile_loop"}, {"code": "design-awaiting-approval", "slide": "knowledge_check"}]},
    {"id": "stale-reply", "given": "proposed",
     "run": ["design", "respond", "--project", "{project}", "--file", "{fixture}/refusals/stale-reply.json", "--json"],
     "problems": [{"code": "design-revision-stale", "recoverable": true}]},
    {"id": "composition-not-approved", "given": "proposed",
     "run": ["compose", "compile", "--file", "{fixture}/composition.json", "--design-project", "{project}", "--output", "{output}", "--json"],
     "problems": [{"code": "design-awaiting-approval", "slide": "operator_architecture"}, {"code": "design-awaiting-approval", "slide": "reconcile_loop"}, {"code": "design-awaiting-approval", "slide": "knowledge_check"}]},
    {"id": "composition-reordered", "given": "approved",
     "run": ["compose", "compile", "--file", "{fixture}/refusals/composition-reordered.json", "--design-project", "{project}", "--output", "{output}", "--json"],
     "problems": [{"code": "design-mismatch", "slide": "reconcile_loop", "recoverable": true}]},
    {"id": "composition-reordered-check-only", "given": "approved",
     "run": ["compose", "compile", "--file", "{fixture}/refusals/composition-reordered.json", "--design-project", "{project}", "--json"],
     "problems": [{"code": "design-mismatch", "slide": "reconcile_loop", "recoverable": true}]},
    {"id": "section-missing-slide", "given": "approved",
     "run": ["compose", "compile", "--file", "{fixture}/refusals/section-missing-slide.json", "--design-project", "{project}", "--section", "--json"],
     "problems": [{"code": "design-mismatch", "slide": "reconcile_loop", "recoverable": true}]},
    {"id": "image-missing", "given": "empty",
     "run": ["compose", "compile", "--file", "{fixture}/refusals/composition-missing-image.json", "--output", "{output}", "--json"],
     "problems": [{"code": "asset-missing", "slide": "console_view", "asset": "console_screenshot", "recoverable": true}]},
    {"id": "image-asset-unrecorded", "given": "empty",
     "run": ["compose", "compile", "--file", "{fixture}/refusals/composition-unknown-asset.json", "--asset-project", "{project}", "--output", "{output}", "--json"],
     "problems": [{"code": "asset-unresolved", "slide": "console_view", "asset": "console_screenshot", "recoverable": true}]},
    {"id": "candidates-unrecorded", "given": "proposed",
     "run": ["assets", "check", "--project", "{project}", "--design-project", "{project}", "--json"],
     "problems": [{"code": "asset-unresolved", "slide": "operator_architecture", "asset": "icon_kubernetes", "recoverable": true}, {"code": "asset-unresolved", "slide": "operator_architecture", "asset": "icon_pod", "recoverable": true}]}
  ]
}
